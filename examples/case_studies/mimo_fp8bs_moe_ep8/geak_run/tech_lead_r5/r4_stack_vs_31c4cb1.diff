+def _fma_sc4(a, s, c):
+    """a * s + c on f32xN vectors as N scalar llvm.fma (v_fma_f32); element i uses s[i] (per-row scale)."""
+    a, s, c = arith.unwrap(a), arith.unwrap(s), arith.unwrap(c)
+    nel = ir.VectorType(a.type).shape[0]
+    outs = []
+    for i in range(nel):
+        ai = vector.extract(a, static_position=[i], dynamic_position=[])
+        si = vector.extract(s, static_position=[i], dynamic_position=[])
+        ci = vector.extract(c, static_position=[i], dynamic_position=[])
+        outs.append(fmath.fma(arith.unwrap(ai), arith.unwrap(si), arith.unwrap(ci)))
+    return vector.from_elements(T.vec(nel, T.f32), outs)
+
+
+def _mul_sc4(a, b, b_scalar=False):
+    """Element-wise a * b of f32xN vectors (b_scalar: b is one f32) as N scalar arith.mulf (v_mul_f32)."""
+    a, b = arith.unwrap(a), arith.unwrap(b)
+    nel = ir.VectorType(a.type).shape[0]
+    b_vec = not b_scalar
+    outs = []
+    for i in range(nel):
+        ai = _w(vector.extract(a, static_position=[i], dynamic_position=[]))
+        bi = _w(vector.extract(b, static_position=[i], dynamic_position=[])) if b_vec else _w(b)
+        outs.append(arith.unwrap(ai * bi))
+    return vector.from_elements(T.vec(nel, T.f32), outs)
 
 
