+def _sst_emit(addr_i64, datas, kind_s, pol=0):
+    """One straight-line inline-asm block per epilogue row (r4_d1 single-row plain stores):
+         saved = exec
+         exec  = (kind == 1) ? saved : 0 -> global_store_dword x n        (token with exactly one local entry)
+         exec  = (kind == 2) ? saved : 0 -> global_atomic_pk_add_bf16 x n (multi-local-expert token)
+         exec  = saved
+    addr_i64: per-lane 64-bit byte address of this row's first 128-col chunk; datas[hc]: packed 2 x bf16 of chunk hc
+    (byte offset hc*256). kind_s: uniform i32 in an SGPR (readfirstlane), 0 = padding (no memory op at all).
+    exec is only modified inside the asm block, so no compiler-scheduled VALU can run under the narrowed mask
+    (a 64-bit mask operand with an "s" constraint was silently given VGPRs, hence the SCC/s_cmov form)."""
+    n = len(datas)
+    pst = _SST_POLS[int(pol)]
+    lines = ["s_mov_b64 $0, exec", "s_cmp_lg_u32 $1, 1", "s_cmov_b64 exec, 0"]
+    for hc in range(n):
+        lines.append(f"global_store_dword $2, ${3 + hc}, off" + (f" offset:{hc * 256}" if hc else "") + pst)
+    lines += ["s_mov_b64 exec, $0", "s_cmp_lg_u32 $1, 2", "s_cmov_b64 exec, 0"]
+    for hc in range(n):
+        lines.append(f"global_atomic_pk_add_bf16 $2, ${3 + hc}, off" + (f" offset:{hc * 256}" if hc else ""))
+    lines.append("s_mov_b64 exec, $0")
+    cons = "=&s,s,v," + ",".join(["v"] * n) + ",~{scc},~{memory}"
+    ops = [arith.unwrap(kind_s), arith.unwrap(addr_i64)] + [arith.unwrap(d) for d in datas]
+    llvm.inline_asm(T.i64, ops, "\n".join(lines), cons, has_side_effects=True)
+
