+
+    lds_x_bytes = 2 * tile_m * lds_stride
+    lds_out_bytes = 2 * tile_m * tile_n
+    lds_bytes = max(lds_x_bytes, lds_out_bytes)
+    lds_off = allocator._align(allocator.ptr, 16)
+    allocator.ptr = lds_off + lds_bytes
