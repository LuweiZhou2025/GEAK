+                stream)
+        return out
+    exe(out.view(-1), a2.view(-1), a2_scale.view(-1), w2.view(-1), w2_scale_flat.view(-1),
+        sorted_ids, sorted_weights, sorted_expert_ids, num_valid_ids, cnt_arg, tokens, blocks, S, grid_m, stream)
+    return out
