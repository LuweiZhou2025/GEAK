+        bh = _mv.extract_strided_slice(v2, b, [2 * h], [2], [1])
+        ch = _mv.extract_strided_slice(v2, c, [2 * h], [2], [1])
+        outs.append(mmath.fma(ah, bh, ch))
+    r = _mv.shuffle(outs[0], outs[1], [0, 1, 2, 3])
+    return r
+
+
+_SCHED_MODE = int(_os.environ.get("FBS_SCHED", "3"))
