+def _if_then(if_op):
+    class _Ctx:
+        def __enter__(self):
+            self.ip = ir.InsertionPoint(if_op.then_block)
+            self.ip.__enter__()
+            return if_op.then_block
+
+        def __exit__(self, *a):
+            blk = if_op.then_block
+            if (not blk.operations) or not isinstance(blk.operations[-1], scf.YieldOp):
+                scf.YieldOp([])
+            self.ip.__exit__(*a)
+            return False
+
+    return _Ctx()
